{
  "name": "gameplay",
  "version": "1.0.0",
  "description": "Self-hosted media player for Unraid",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npx vite",
    "build": "cd client && npx vite build",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "chokidar": "^3.6.0",
    "express": "^4.18.3",
    "fast-glob": "^3.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "mime-types": "^2.1.35",
    "p-queue": "^8.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
